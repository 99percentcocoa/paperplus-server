# Copy to infra/.env and fill in real values; never commit the real .env.
#
# This one file is passed to BOTH services via `env_file: .env` in docker-compose.yml. The
# shared secret between them needs to be set under two different variable names because each
# service's Settings class names the field differently (api-service: vision_service_shared_secret
# -> VISION_SERVICE_SHARED_SECRET; vision-service: shared_secret -> SHARED_SECRET) -- keep both
# lines identical or api-service's calls to vision-service will get 401s.
VISION_SERVICE_SHARED_SECRET=change-me
SHARED_SECRET=change-me

# When true, outgoing WhatsApp sends (send_message/send_image) are logged instead of actually
# calling Exotel -- keep this true until real Exotel credentials below are filled in, otherwise
# every graded scan will attempt (and fail) a real API call.
LOCAL_MODE=true

# Base URL this deployment is publicly reachable at -- used to build the checked-image URL sent
# over WhatsApp and logged to Sheets. Must be internet-fetchable in production (not needed while
# LOCAL_MODE=true, since sends are only logged then). Point this at nginx (NGINX_HOST_PORT below),
# the actual public front door, not api-service's own port directly -- keep the port in sync with
# NGINX_HOST_PORT if you change it. On a real deploy, replace localhost with the VM's real
# public IP/domain.
PUBLIC_BASE_URL=http://localhost:8080

EXOTEL_SID=
EXOTEL_KEY=
EXOTEL_TOKEN=
EXOTEL_SUBDOMAIN=
SHEETS_LOGGING_URL=

# Host port nginx binds to (docker-compose.yml reads this directly, not via env_file -- it must
# live in this file, read automatically by `docker compose` since it sits next to
# docker-compose.yml). Defaults to 8080 if unset. Set to 80 on a deploy VM where that port is
# actually free.
NGINX_HOST_PORT=8080

# Host port the postgres container binds to (same read mechanism as NGINX_HOST_PORT above).
# Defaults to 5433, not 5432, since dev machines here also run a local (non-docker) Postgres on
# 5432 -- only affects host-side psql access, not api-service's internal DATABASE_URL.
POSTGRES_HOST_PORT=5433

# Admin dashboard alert thresholds (all optional; defaults shown). Alerts appear as banners on
# /admin and a red/amber/green dot in its topbar -- nothing is pushed anywhere.
# ALERT_FAILURE_RATE=0.3              # failed / all scans over 24h
# ALERT_MIN_SCANS_FOR_FAILURE_RATE=5  # stay quiet below this many scans
# ALERT_VISION_FAILURES_1H=3          # scans lost to vision-service errors in the last hour
# ALERT_OPEN_REVIEWS=10               # failed scans waiting for review
# ALERT_REVIEW_AGE_HOURS=24           # oldest unreviewed failed scan
# ALERT_DISK_WARN_PCT=85
# ALERT_DISK_CRITICAL_PCT=95
# ALERT_SILENCE_HOURS=48              # no scans at all for this long (0 disables) -- check the Exotel webhook
